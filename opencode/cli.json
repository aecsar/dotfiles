{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "rosepine"
  },
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "scroll": {
    "speed": 3
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
